# Kopiera till .env och fyll i. Alla värden är valfria; utan dem används platshållare.

# Branding
VITE_BRAND_NAME=Zero Diff
VITE_TICKER=ZERODIFF
# pump.fun-mint. Lämna tomt för att dölja token-pillen i hero och footer.
VITE_TOKEN_CA=
VITE_X_URL=https://x.com/zerodiffsol
VITE_SITE_URL=https://zerodiff.fun

# Protokolladresser som visas på /vault och i docs
VITE_VAULT_ADDRESS=
VITE_ORPHAN_FUND_ADDRESS=
VITE_KEEPER_ADDRESS=

# Visa "Demo wallet" i produktionsbuild (alltid på i dev)
VITE_DEMO_WALLET=false
